# ==============================================================================
# WorkSphere - Environment Configuration Template
# All secret values below are non-production placeholders.
# Copy this file to .env before starting the services.
# ==============================================================================

# Core System
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_BASE_URL=http://localhost:3000

# PostgreSQL System of Record
DATABASE_URL=postgres://worksphere:worksphere_secret@localhost:5432/worksphere_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=worksphere_db
DB_USER=worksphere
DB_PASSWORD=worksphere_secret
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=5000

# Redis Cache and Queues
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication and Tokens
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=10

# Python FastAPI Analytics Service
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_SERVICE_API_KEY=m2m-service-token-worksphere-analytics-2026
PYTHON_SERVICE_PORT=8000

# Object Storage (S3 / MinIO compatible)
STORAGE_PROVIDER=local
STORAGE_BUCKET=worksphere-attachments
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# Email Service (Sandbox / Mock / SMTP)
EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@worksphere.io

# Outgoing Webhooks Security
WEBHOOK_SIGNING_SECRET=whsec_worksphere_test_signing_secret_xyz123

# Frontend Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ANALYTICS_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=WorkSphere
