{
  "openapi": "3.0.3",
  "info": {
    "title": "WorkSphere Core Business REST API",
    "version": "1.0.0",
    "description": "Multi-tenant project management, task tracking, workflow automation, and optimistic concurrency control API for WorkSphere.",
    "contact": {
      "name": "WorkSphere Engineering Team",
      "email": "api@worksphere.io"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000/api/v1",
      "description": "Local development environment"
    },
    {
      "url": "https://api.worksphere.io/api/v1",
      "description": "Production environment"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "TenantHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Organization-Id"
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register new user and primary organization",
        "tags": ["Authentication"]
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user credentials",
        "tags": ["Authentication"]
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Rotate refresh tokens with token family reuse revocation",
        "tags": ["Authentication"]
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get current authenticated profile and organization memberships",
        "tags": ["Authentication"],
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/organizations": {
      "get": {
        "summary": "List organizations",
        "tags": ["Organizations"],
        "security": [{ "BearerAuth": [] }]
      },
      "post": {
        "summary": "Create new organization",
        "tags": ["Organizations"],
        "security": [{ "BearerAuth": [] }]
      }
    },
    "/organizations/{orgId}/projects": {
      "get": {
        "summary": "List tenant projects",
        "tags": ["Projects"],
        "security": [{ "BearerAuth": [] }, { "TenantHeader": [] }]
      },
      "post": {
        "summary": "Create project (org_owner, project_manager)",
        "tags": ["Projects"],
        "security": [{ "BearerAuth": [] }, { "TenantHeader": [] }]
      }
    },
    "/organizations/{orgId}/tasks": {
      "get": {
        "summary": "List tenant tasks with status and assignee filters",
        "tags": ["Tasks"],
        "security": [{ "BearerAuth": [] }, { "TenantHeader": [] }]
      },
      "post": {
        "summary": "Create task",
        "tags": ["Tasks"],
        "security": [{ "BearerAuth": [] }, { "TenantHeader": [] }]
      }
    },
    "/organizations/{orgId}/tasks/{taskId}": {
      "patch": {
        "summary": "Update task with Optimistic Concurrency Control (version counter)",
        "tags": ["Tasks"],
        "security": [{ "BearerAuth": [] }, { "TenantHeader": [] }]
      },
      "delete": {
        "summary": "Delete task",
        "tags": ["Tasks"],
        "security": [{ "BearerAuth": [] }, { "TenantHeader": [] }]
      }
    },
    "/organizations/{orgId}/activities": {
      "get": {
        "summary": "Immutable activity audit stream",
        "tags": ["Activity"],
        "security": [{ "BearerAuth": [] }, { "TenantHeader": [] }]
      }
    },
    "/webhooks/incoming": {
      "post": {
        "summary": "Incoming webhook with HMAC-SHA256 signature verification and replay prevention",
        "tags": ["Webhooks"]
      }
    }
  }
}
